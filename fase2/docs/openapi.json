 "components": {
  "schemas": {
   "ConfigGA": {
    "properties": {
     "geracoes": {
      "type": "integer",
      "maximum": 5000.0,
      "minimum": 1.0,
      "title": "Geracoes",
      "description": "Máximo de gerações",
      "default": 400
     },
     "populacao": {
      "type": "integer",
      "maximum": 1000.0,
      "minimum": 10.0,
      "title": "Populacao",
      "description": "Tamanho da população",
      "default": 120
     },
     "seed": {
      "type": "integer",
      "title": "Seed",
      "description": "Semente (mesma semente → mesmo resultado)",
      "default": 42
     },
     "crossover": {
      "type": "string",
      "enum": [
       "mix",
       "ox",
       "pmx",
       "erx",
       "bcrc"
      ],
      "title": "Crossover",
      "default": "mix"
     },
     "selecao": {
      "type": "string",
      "enum": [
       "tournament",
       "roulette",
       "rank",
       "truncation"
      ],
      "title": "Selecao",
      "default": "tournament"
     },
     "taxa_mutacao": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Taxa Mutacao",
      "default": 0.4
     },
     "elitismo": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 0.0,
      "title": "Elitismo",
      "default": 2
     },
     "sementes_heuristicas": {
      "type": "boolean",
      "title": "Sementes Heuristicas",
      "description": "Inclui soluções heurísticas na população inicial",
      "default": true
     },
     "busca_local": {
      "type": "boolean",
      "title": "Busca Local",
      "description": "GA memético (2-opt/relocate no melhor)",
      "default": true
     },
     "paciencia": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Paciencia",
      "description": "Para após N gerações sem melhora",
      "default": 250
     },
     "tempo_limite_s": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Tempo Limite S",
      "description": "Limite de tempo em segundos"
     }
    },
    "type": "object",
    "title": "ConfigGA"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PedidoCenario": {
    "properties": {
     "seed": {
      "type": "integer",
      "title": "Seed",
      "default": 42
     },
     "utilizacao_alvo": {
      "type": "number",
      "maximum": 1.2,
      "exclusiveMinimum": 0.0,
      "title": "Utilizacao Alvo",
      "description": "Fração da capacidade da frota ocupada pela demanda",
      "default": 0.68
     },
     "composicao": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "integer"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Composicao",
      "description": "Ex.: {\"UBS\": 8, \"UPA\": 4, \"AME\": 3, \"Hospital Dia\": 2, \"CAPS\": 3, \"Domiciliar\": 16}"
     },
     "data": {
      "type": "string",
      "title": "Data",
      "default": "2026-10-13"
     }
    },
    "type": "object",
    "title": "PedidoCenario"
   },
   "PedidoComparacao": {
    "properties": {
     "cenario": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cenario"
     },
     "metodos": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Metodos",
      "description": "Opções: vizinho_mais_proximo, despachante_prioridade, clarke_wright, sweep, simulated_annealing, tsp_base_split, busca_aleatoria, melhoria_local, ortools"
     },
     "incluir_ga": {
      "type": "boolean",
      "title": "Incluir Ga",
      "default": true
     },
     "ortools_tempo_s": {
      "type": "integer",
      "maximum": 120.0,
      "minimum": 1.0,
      "title": "Ortools Tempo S",
      "default": 10
     }
    },
    "type": "object",
    "title": "PedidoComparacao"
   },
   "PedidoOtimizacao": {
    "properties": {
     "cenario": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cenario",
      "description": "Cenário no formato de GET /cenarios/padrao. Omitido = cenário padrão."
     },
     "config": {
      "$ref": "#/components/schemas/ConfigGA"
     },
     "pesos": {
      "$ref": "#/components/schemas/PesosFitness"
     },
     "incluir_historico": {
      "type": "boolean",
      "title": "Incluir Historico",
      "description": "Devolve a curva de convergência",
      "default": false
     }
    },
    "type": "object",
    "title": "PedidoOtimizacao"
   },
   "Pergunta": {
    "properties": {
     "pergunta": {
      "type": "string",
      "minLength": 3,
      "title": "Pergunta",
      "examples": [
       "Qual veículo leva a insulina do PD-05?"
      ]
     },
     "historico": {
      "items": {
       "prefixItems": [
        {
         "type": "string"
        },
        {
         "type": "string"
        }
       ],
       "type": "array",
       "maxItems": 2,
       "minItems": 2
      },
      "type": "array",
      "title": "Historico",
      "description": "Pares (pergunta, resposta) anteriores"
     }
    },
    "type": "object",
    "required": [
     "pergunta"
    ],
    "title": "Pergunta"
   },
   "PesosFitness": {
    "properties": {
     "distancia": {
      "type": "number",
      "title": "Distancia",
      "description": "Peso por km",
      "default": 1.0
     },
     "prioridade": {
      "type": "number",
      "title": "Prioridade",
      "description": "Peso por (peso da prioridade × hora de chegada)",
      "default": 1.0
     },
     "atraso": {
      "type": "number",
      "title": "Atraso",
      "description": "Peso por (peso da prioridade × minuto de atraso)",
      "default": 1.0
     },
     "custo": {
      "type": "number",
      "title": "Custo",
      "description": "Peso por R$ (0 = desligado)",
      "default": 0.0
     }
    },
    "type": "object",
    "title": "PesosFitness"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 },
 "tags": [
  {
   "name": "sistema",
   "description": "Saúde da API e configuração."
  },
  {
   "name": "cenários",
   "description": "Instâncias do problema (um dia de operação)."
  },
  {
   "name": "otimização",
   "description": "Algoritmo genético e abordagens de comparação."
  },
  {
   "name": "planos",
   "description": "Planos de rota gerados (consulta e mapa)."
  },
  {
   "name": "llm",
   "description": "Produtos da LLM sobre um plano."
  }
 ]
}