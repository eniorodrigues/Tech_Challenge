{
 "openapi": "3.1.0",
 "info": {
  "title": "MedRoute API",
  "description": "Otimização de rotas para distribuição de medicamentos e insumos hospitalares (VRP com prioridades, capacidade, autonomia, frota heterogênea, cadeia fria, controlados e janelas de horário) por **algoritmo genético**, com uma **LLM** gerando instruções, relatórios, sugestões e respostas em linguagem natural.\n\nTech Challenge — Fase 2 (FIAP · IA para Devs).",
  "version": "2.0.0"
 },
