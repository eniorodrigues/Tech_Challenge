# Copie para .env e preencha. O .env NÃO vai para o git.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)

# Chave da OpenRouter (https://openrouter.ai/keys). Só modelos gratuitos são usados.
# Sem chave o sistema funciona em modo offline (textos por template).
OPENROUTER_API_KEY=

# Opcional: cadeia de modelos (separados por vírgula), do preferido ao último recurso.
# MEDROUTE_LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
